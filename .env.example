# ── AIM 설정 (.env로 복사 후 값 입력. .env는 절대 커밋 금지) ──

# 동작 모드
AIM_DRY_RUN=true                # true면 외부 발송 없이 콘솔 출력
AIM_DB_PATH=data/aim.db

# 텔레그램 (P1)
AIM_TELEGRAM_BOT_TOKEN=
AIM_TELEGRAM_CHAT_ID=

# 디스코드 서버 자동 관리 (aim discord-setup) — 봇이 채널·웹훅을 알아서 생성
# Developer Portal에서 봇 생성 후 토큰 입력. 봇이 여러 서버에 있으면 GUILD_ID도 지정
AIM_DISCORD_BOT_TOKEN=
AIM_DISCORD_GUILD_ID=

# 디스코드 — 채널별 웹훅 (discord-setup이 자동 기록. 수동 설정도 가능)
# 필요한 것만 설정하면 됨. 미설정 route는 자동 폴백:
#   kr/us → default | surge/disclosure → signals → default
AIM_DISCORD_WEBHOOK_URL=            # 기본(폴백) 채널
AIM_DISCORD_WEBHOOK_KR=             # #한국장-브리핑
AIM_DISCORD_WEBHOOK_US=             # #미국장-브리핑
AIM_DISCORD_WEBHOOK_SIGNALS=        # #관심종목-시그널 (급등주+공시 통합)
AIM_DISCORD_WEBHOOK_SURGE=          # #급등주 (분리 운영 시)
AIM_DISCORD_WEBHOOK_DISCLOSURE=     # #공시 (분리 운영 시)

# KIS 한국투자증권 (조회 전용 — 실전 계정 키 권장, §11.1)
AIM_KIS_APP_KEY=
AIM_KIS_APP_SECRET=
AIM_KIS_ENV=prod                # prod | vps(모의)

# OpenDART 전자공시 (무료 — https://opendart.fss.or.kr 에서 발급, 일 20,000콜)
AIM_DART_API_KEY=

# LLM 2-티어 (P2 두뇌)
# 딥씽킹(판정자) = Codex CLI — ChatGPT 구독 OAuth, `codex login` 상태면 설정 불필요
AIM_CODEX_MODEL=                    # 비우면 Codex CLI 기본 모델
# 퀵씽킹(애널리스트) = MiniMax API (https://platform.minimax.io 에서 키 발급)
AIM_MINIMAX_API_KEY=
AIM_MINIMAX_MODEL=MiniMax-M2
AIM_MINIMAX_BASE_URL=https://api.minimax.io/v1   # 중국 본토 키면 https://api.minimaxi.com/v1
